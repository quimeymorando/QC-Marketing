---
// Pantalla de EJEMPLO para el portfolio (se reemplaza por capturas o video reales).
const { i = 0, hue = 190, small = false } = Astro.props;
const bg = `hsl(${hue} 46% 11%)`, mid = `hsl(${hue} 40% 20%)`, hi = `hsl(${hue} 55% 62%)`, fg = '#F2F6F7';
const v = i % 5;
---
<svg viewBox="0 0 640 376" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Pantalla de ejemplo">
  <rect width="640" height="376" fill={bg} />
  <g fill={fg} opacity=".5"><rect x="28" y="24" width="46" height="5" /><rect x="470" y="24" width="30" height="5" /><rect x="514" y="24" width="30" height="5" /><rect x="558" y="24" width="54" height="5" /></g>
  {v === 0 && <g><circle cx="470" cy="210" r="150" fill={mid} /><circle cx="470" cy="210" r="92" fill="none" stroke={hi} stroke-width="1.2" /><rect x="28" y="120" width="300" height="34" fill={fg} /><rect x="28" y="166" width="230" height="34" fill={fg} /><rect x="28" y="226" width="200" height="6" fill={fg} opacity=".5" /><rect x="28" y="242" width="170" height="6" fill={fg} opacity=".5" /><rect x="28" y="284" width="118" height="34" fill={hi} /></g>}
  {v === 1 && <g><rect x="28" y="70" width="584" height="150" fill={mid} /><path d="M28 190 C 180 130 300 230 440 160 S 612 150 612 150 V220 H28Z" fill={hi} opacity=".5" /><rect x="28" y="246" width="340" height="30" fill={fg} /><rect x="28" y="290" width="200" height="6" fill={fg} opacity=".5" /><rect x="494" y="250" width="118" height="34" fill="none" stroke={fg} /></g>}
  {v === 2 && <g><rect x="28" y="96" width="250" height="26" fill={fg} /><rect x="28" y="132" width="190" height="26" fill={fg} /><rect x="28" y="186" width="210" height="6" fill={fg} opacity=".5" /><rect x="28" y="202" width="180" height="6" fill={fg} opacity=".5" /><rect x="340" y="76" width="272" height="250" rx="14" fill={mid} /><rect x="362" y="100" width="150" height="26" rx="13" fill={bg} /><rect x="440" y="138" width="150" height="26" rx="13" fill={hi} /><rect x="362" y="176" width="190" height="26" rx="13" fill={bg} /><rect x="362" y="284" width="228" height="24" rx="12" fill="none" stroke={fg} opacity=".5" /></g>}
  {v === 3 && <g><rect x="28" y="70" width="280" height="262" fill={mid} /><circle cx="168" cy="200" r="70" fill="none" stroke={hi} stroke-width="1.2" /><circle cx="168" cy="200" r="40" fill={hi} opacity=".5" /><rect x="340" y="110" width="250" height="30" fill={fg} /><rect x="340" y="152" width="170" height="30" fill={fg} /><rect x="340" y="212" width="220" height="6" fill={fg} opacity=".5" /><rect x="340" y="228" width="190" height="6" fill={fg} opacity=".5" /><rect x="340" y="270" width="118" height="34" fill={hi} /></g>}
  {v === 4 && <g><rect x="120" y="110" width="400" height="40" fill={fg} /><rect x="180" y="162" width="280" height="40" fill={fg} /><rect x="220" y="232" width="200" height="6" fill={fg} opacity=".5" /><rect x="261" y="268" width="118" height="34" fill={hi} /><path d="M0 340 C 120 310 200 360 320 336 S 520 310 640 344 V376 H0Z" fill={mid} /></g>}
  {!small && <text x="612" y="356" text-anchor="end" font-family="Martian Mono, monospace" font-size="9" letter-spacing="1.5" fill={fg} opacity=".55">PANTALLA DE EJEMPLO</text>}
</svg>
