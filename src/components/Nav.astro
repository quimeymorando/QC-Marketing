---
import Logo from './Logo.astro';
import { nav } from '../data/home';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="nav" data-hide="0">
  <div class="wrap nav-in">
    <a class="nav-logo" href="/" aria-label="Ceto Studio, inicio" data-cursor="Inicio">
      <Logo />
      <span>Ceto Studio</span>
    </a>
    <nav class="nav-links" aria-label="Principal">
      {nav.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <a class="nav-cta" href="/#contacto">Hablemos ↗</a>
    <button class="nav-burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu"></button>
  </div>
</header>
<div class="menu" id="menu">
  {nav.map((l) => <a href={l.href}>{l.label}</a>)}
  <a class="btn" href="/#contacto">Hablemos <i>→</i></a>
</div>
