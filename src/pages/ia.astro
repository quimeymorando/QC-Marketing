---
import Base from '../layouts/Base.astro';
---
<Base title="IA — Ceto Studio" page="inner" depth={1600}>
  <main>
    <section class="inner" data-depth="1600">
      <div class="wrap">
        <p class="label" data-tw>Ceto Studio · en construcción</p>
        <h1 class="inner-title display" data-tw data-tw-step="70" data-tw-caret="stay" data-tw-name="t">IA</h1>
        <p class="inner-text" data-tw data-tw-after="t">Estamos preparando esta página. En la home te contamos cómo trabaja un asistente entrenado con la información de tu negocio.</p>
        <p class="inner-actions"><a class="btn" href="/#abismo">Ver cómo funciona <i>→</i></a></p>
      </div>
    </section>
  </main>
</Base>
