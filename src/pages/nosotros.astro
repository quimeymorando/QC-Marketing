---
import Base from '../layouts/Base.astro';
---
<Base title="Nosotros — Ceto Studio" page="inner" depth={120}>
  <main>
    <section class="inner" data-depth="120">
      <div class="wrap">
        <p class="label" data-tw>Ceto Studio · en construcción</p>
        <h1 class="inner-title display" data-tw data-tw-step="70" data-tw-caret="stay" data-tw-name="t">Nosotros</h1>
        <p class="inner-text" data-tw data-tw-after="t">Estamos preparando esta página. En la home puedes conocer a las dos personas que hacen Ceto Studio.</p>
        <p class="inner-actions"><a class="btn" href="/#equipo">Conocer al equipo <i>→</i></a></p>
      </div>
    </section>
  </main>
</Base>
