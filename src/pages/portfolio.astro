---
import Base from '../layouts/Base.astro';
---
<Base title="Portfolio — Ceto Studio" page="inner" depth={700}>
  <main>
    <section class="inner" data-depth="700">
      <div class="wrap">
        <p class="label" data-tw>Ceto Studio · en construcción</p>
        <h1 class="inner-title display" data-tw data-tw-step="70" data-tw-caret="stay" data-tw-name="t">Portfolio</h1>
        <p class="inner-text" data-tw data-tw-after="t">Estamos preparando esta página. Mientras tanto, en la home puedes ver algunos trabajos.</p>
        <p class="inner-actions"><a class="btn" href="/#portfolio">Ver los trabajos <i>→</i></a></p>
      </div>
    </section>
  </main>
</Base>
