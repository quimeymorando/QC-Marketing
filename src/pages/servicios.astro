---
import Base from '../layouts/Base.astro';
---
<Base title="Servicios — Ceto Studio" page="inner" depth={300}>
  <main>
    <section class="inner" data-depth="300">
      <div class="wrap">
        <p class="label" data-tw>Ceto Studio · en construcción</p>
        <h1 class="inner-title display" data-tw data-tw-step="70" data-tw-caret="stay" data-tw-name="t">Servicios</h1>
        <p class="inner-text" data-tw data-tw-after="t">Estamos preparando esta página. En la home te contamos qué problemas resolvemos, zona por zona.</p>
        <p class="inner-actions"><a class="btn" href="/#superficie">Ver qué resolvemos <i>→</i></a></p>
      </div>
    </section>
  </main>
</Base>
